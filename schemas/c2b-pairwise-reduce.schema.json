{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c2b-pairwise-reduce.schema.json",
  "title": "c2b-pairwise-reduce output",
  "type": "object",
  "required": ["bhv_id", "reducer", "reduced_rows", "dropped_row_ids", "pairwise_coverage_verified"],
  "additionalProperties": false,
  "properties": {
    "bhv_id": { "type": "string", "pattern": "^BHV-[0-9]{4,}$" },
    "reducer": { "type": "string", "enum": ["pict", "acts"] },
    "reduced_rows": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Subset of c2's is_configuration_dimension rows plus all non-configuration rows passed through unchanged."
    },
    "dropped_row_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Configuration-dimension row_ids removed by reduction; never includes an MC/DC row_id."
    },
    "pairwise_coverage_verified": { "type": "boolean" }
  }
}
