{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a4-confirm-edge-inference.schema.json",
  "title": "a4-confirm-edge-inference output",
  "type": "object",
  "required": ["edge_ref", "verdict", "evidence", "confidence"],
  "additionalProperties": false,
  "properties": {
    "edge_ref": {
      "type": "object",
      "required": ["from", "edge_type"],
      "properties": { "from": { "type": "string" }, "edge_type": { "type": "string" } }
    },
    "verdict": {
      "type": "string",
      "description": "Either one of the supplied candidate node IDs, or one of the two escape values.",
      "not": { "enum": [""] }
    },
    "chosen_targets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-empty only when verdict == 'multiple'."
    },
    "evidence": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
