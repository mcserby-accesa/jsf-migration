{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "b2-confirm-rule-behavior.schema.json",
  "title": "b2-confirm-rule-behavior output",
  "type": "object",
  "required": ["cluster_id", "verdict", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "cluster_id": { "type": "string" },
    "verdict": { "type": "string", "enum": ["confirmed", "rejected", "partial_split"] },
    "groups": {
      "type": "array",
      "description": "Required and must partition all input members when verdict == partial_split; omitted otherwise.",
      "items": {
        "type": "object",
        "required": ["member_node_ids", "is_genuine_rule"],
        "properties": {
          "member_node_ids": { "type": "array", "items": { "type": "string" } },
          "is_genuine_rule": { "type": "boolean" }
        }
      }
    },
    "reasoning": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
