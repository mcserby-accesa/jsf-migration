{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c3-render-tests.schema.json",
  "title": "c3-render-tests output",
  "type": "object",
  "required": ["bhv_id", "spec_format", "outputs"],
  "additionalProperties": false,
  "properties": {
    "bhv_id": { "type": "string", "pattern": "^BHV-[0-9]{4,}$" },
    "spec_format": { "type": "string", "enum": ["gherkin", "junit", "both"] },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "path", "content_hash", "source_ac_ids"],
        "properties": {
          "format": { "type": "string", "enum": ["gherkin", "junit"] },
          "path": { "type": "string" },
          "content_hash": { "type": "string", "description": "Used to verify re-rendering idempotence." },
          "source_ac_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Every AC/decision-table row id covered; must match across formats when spec_format == both."
          }
        }
      }
    }
  }
}
