{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a1-extract-inventory.schema.json",
  "title": "One line of nodes.jsonl or edges.jsonl produced by a1",
  "description": "Each line in nodes.jsonl validates against $defs.node; each line in edges.jsonl validates against $defs.edge. See docs/phase-a-inventory.md for the full node/edge type list.",
  "oneOf": [
    { "$ref": "#/$defs/node" },
    { "$ref": "#/$defs/edge" }
  ],
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "label", "legacy_refs", "extracted_by", "extraction_confidence", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^(SCR|SVC|RULE|PROC|TASK|JOB|NAV|DB|EL|CFG|AUTHZ|AUTHN|TPL)-[0-9]{4,}$" },
        "kind": {
          "type": "string",
          "enum": ["screen", "service", "rule", "process", "task", "job", "navigation", "db", "el", "config", "authz", "authn", "template"]
        },
        "label": { "type": "string" },
        "legacy_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "extracted_by": { "type": "string" },
        "extraction_confidence": { "type": "string", "enum": ["certain", "ambiguous", "rejected"] },
        "classification_source": { "type": "string", "enum": ["script", "llm"] },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "raw_facts": {
          "type": "object",
          "description": "Kind-specific; see docs/phase-a-inventory.md. Deliberately open here rather than modelled per kind — the extraction rules are the authority and the a5 validators enforce presence. Two sub-structures are large enough to have their own schema and MUST validate against it: SCR/TPL raw_facts.layout_tree against schemas/layout-tree.schema.json, and SCR raw_facts.layout_template against its $defs there."
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "type", "evidence"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["RENDERS", "INVOKES", "NAVIGATES_TO", "TRIGGERS", "READS", "WRITES", "STARTS", "CONTAINS", "SCHEDULES", "GUARDS", "DERIVED_FROM", "VALIDATED_BY", "CONVERTED_BY", "RESTRICTS", "COMPOSES_INTO", "INCLUDES", "COVERS"]
        },
        "evidence": { "type": "string", "minLength": 1 },
        "extraction_confidence": { "type": "string", "enum": ["certain", "ambiguous", "rejected"] },
        "candidate_targets": {
          "type": "array",
          "items": { "type": "object", "required": ["node_id", "evidence"], "properties": { "node_id": { "type": "string" }, "evidence": { "type": "string" } } }
        }
      },
      "additionalProperties": false
    }
  }
}
