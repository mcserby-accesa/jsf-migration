{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c3b-verify-rendered-artifacts.schema.json",
  "title": "c3b-verify-rendered-artifacts output",
  "type": "object",
  "required": ["bhv_id", "status", "checks"],
  "additionalProperties": false,
  "properties": {
    "bhv_id": { "type": "string", "pattern": "^BHV-[0-9]{4,}$" },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "parser": {
      "type": "object",
      "description": "Which real parser produced the result. Recorded because 'it parsed' is only meaningful alongside what parsed it — a file accepted by one Gherkin dialect and rejected by another is a finding, not a pass.",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "enum": ["gherkin", "junit"] },
        "tool": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "rendered_artifacts_parse",
              "rendered_scenario_titles_unique",
              "step_text_is_plain_text"
            ]
          },
          "passed": { "type": "boolean" },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["location", "detail"],
              "additionalProperties": false,
              "properties": {
                "location": { "type": "string", "description": "Rendered file path plus line, or the scenario_id whose rendering failed." },
                "detail": { "type": "string" },
                "collides_with": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "For rendered_scenario_titles_unique: the other scenario_ids (in this or another behavior) producing the same title or method name."
                },
                "source_field": {
                  "type": "string",
                  "description": "Which authored BHV field the offending text came from (given/when/then/title/description/expected_outcome), so the fix lands in the canonical document rather than the render."
                }
              }
            }
          }
        }
      }
    }
  }
}
